# AI Chat Feature — required environment variables
# Copy this file to .env.local for local development.
# In Vercel: add these under Project Settings → Environment Variables.
#
# ANTHROPIC_API_KEY: use a key from the dedicated "bmax-portfolio" Anthropic Workspace,
# NOT a key from any other workspace. The dedicated workspace has its own monthly spend
# limit — that is the hard ceiling on cost for this feature.
#
# UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN: from the Upstash console
# after creating the bmax-portfolio Redis database. Shared by both /api/chat
# (rate limiting, session state) and /api/contact (rate limiting, daily cap).
#
# RESEND_API_KEY: from the Resend console (resend.com), used by /api/contact
# to email visitor messages to ben@viewbens.work. Requires the viewbens.work
# domain to be verified in the Resend account (add the DNS records Resend
# provides) — without verification, sends from an address on that domain will
# be rejected. See api/contact.ts's CONTACT_FROM_ADDRESS.

ANTHROPIC_API_KEY=sk-ant-...

UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

RESEND_API_KEY=re_...
